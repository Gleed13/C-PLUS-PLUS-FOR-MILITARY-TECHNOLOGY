          "description": "Увімкнути pretty-printing для STL типів у GDB.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
  ],
  "compounds": [
    {
      // ДЗ 13: піднімає весь граф ROS 2 одразу (5 окремих gdb-сесій),
      // еквівалент ros2 launch antidrone_turret system.launch.py, але під
      // дебагером.
      //
      // Тут свідомо НЕМАЄ "preLaunchTask": VS Code все одно запускає
      // preLaunchTask кожної конфігурації зі списку, і власний preLaunchTask
      // compound-а став би шостим паралельним colcon build у тій самій
      // робочій області. Сам task серіалізований через flock, тому п'ять
      // запусків шикуються в чергу: перший збирає, решта - no-op.
      //
      // Спрацює тільки після того, як у CMakeLists.txt з'являться
      // turret_controller_node, gimbal_driver_node і yaw_servo_driver_node.
      "name": "ROS: Debug ALL antidrone_turret nodes",
      "configurations": [
        "ROS: Debug target_track_publisher_node",
        "ROS: Debug actuator_node",
        "ROS: Debug turret_controller_node",
        "ROS: Debug gimbal_driver_node",
        "ROS: Debug yaw_servo_driver_node"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "antidroneTrackFile",
      "type": "pickString",
      "description": "Select antidrone_turret track CSV",
      "options": [
        "approach_trigger.csv",
        "far_flyby_no_trigger.csv",
        "low_confidence_no_trigger.csv",
        "reload_pressure.csv"
      ],
      "default": "approach_trigger.csv"
    },
    {
      "id": "ugvOdometryInputFile",
      "type": "pickString",
      "description": "Select ugv_odometry input file",
      "options": [
        "straight.txt",
        "turn.txt",
        "combined.txt"
      ],
      "default": "combined.txt"
    },
    {
      "id": "telemetryInputFile",
      "type": "pickString",
      "description": "Select telemetry input file",
      "options": [
        "bad_invalid_number.txt",
        "bad_missing_field.txt",
        "bad_zero_delta.txt",
        "empty.txt",
        "good.txt",
        "not_so_good.txt"
      ],
      "default": "good.txt"
    },
    {
      "id": "ballisticsInputFile",
      "type": "pickString",
      "description": "Select ballistics input file",
      "options": [
        "input.txt",
        "unknown_ammo.txt",
      ],
      "default": "good.txt"
    }
  ]
