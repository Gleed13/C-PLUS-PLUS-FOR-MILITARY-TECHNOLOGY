    },
    {
      // ДЗ 13: запускає готову ноду напряму (без ros2 launch), з тим самим
      // config/sequence.yaml, що й launch/system.launch.py, і обраним треком.
      "name": "ROS: Debug target_track_publisher_node",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/homework_13/robot_ws/install/antidrone_turret/lib/antidrone_turret/target_track_publisher_node",
      "args": [
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/homework_13/robot_ws/install/antidrone_turret/share/antidrone_turret/config/sequence.yaml",
        "-p",
        "track_file:=${workspaceFolder}/homework_13/robot_ws/install/antidrone_turret/share/antidrone_turret/tracks/${input:antidroneTrackFile}",
        "--log-level",
        "debug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/homework_13/robot_ws",
      "envFile": "${workspaceFolder}/homework_13/robot_ws/.vscode_ros_env.env",
      // externalConsole МУСИТЬ бути false у devcontainer. cppdbg надсилає
      // VS Code DAP-запит runInTerminal: при true - kind="external", і VS Code
      // шукає термінальний емулятор (x-terminal-emulator, gnome-terminal,
      // konsole, xterm). В образі курсу жодного з них немає, тому debug-сесія
      // не стартує взагалі. При false - kind="integrated", тобто GDB працює у
      // вбудованому терміналі VS Code з нормальним tty.
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "colcon: build antidrone_turret (debug)",
      "setupCommands": [
        {
          "description": "Увімкнути pretty-printing для STL типів у GDB.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      // ДЗ 13: готова actuator-нода. Приймає /actuator/trigger і публікує
      // READY/RELOADING - зручно ставити breakpoint у ActuatorModel.
      "name": "ROS: Debug actuator_node",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/homework_13/robot_ws/install/antidrone_turret/lib/antidrone_turret/actuator_node",
      "args": [
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/homework_13/robot_ws/install/antidrone_turret/share/antidrone_turret/config/sequence.yaml",
        "--log-level",
        "debug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/homework_13/robot_ws",
      "envFile": "${workspaceFolder}/homework_13/robot_ws/.vscode_ros_env.env",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "colcon: build antidrone_turret (debug)",
      "setupCommands": [
        {
          "description": "Увімкнути pretty-printing для STL типів у GDB.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      // ДЗ 13: студентська нода. Виконуваний файл з'явиться тут щойно у
      // CMakeLists.txt буде доданий ament_auto_add_executable(turret_controller_node ...).
      "name": "ROS: Debug turret_controller_node",
      "type": "cppdbg",
