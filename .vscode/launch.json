{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ugv_odometry",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/homework_04/build/ugv_odometry",
      "args": [
        "data/${input:ugvOdometryInputFile}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/homework_04",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Debug telemetry_check",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/homework_05/build/telemetry_check",
